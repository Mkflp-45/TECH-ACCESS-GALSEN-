rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        // Support custom claim `admin: true` OR fallback to known admin email
        request.auth.token.admin == true || request.auth.token.email == "mohameth2051@gmail.com"
      );
    }

    // Products: public read, admin write
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promotions: authenticated users can read, admin can write
    match /promotions/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Settings: read for authenticated, write for admin
    match /settings/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Orders: creation by authenticated users, full access for admin
    match /orders/{document=**} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin() || (
        // Allow users to read their own orders when the document contains a customer.uid field
        isSignedIn() && resource.data.customer.uid == request.auth.uid
      );
    }

    // Admin logs: admin only
    match /adminLogs/{document=**} {
      allow read, write: if isAdmin();
    }

    // Users: user can read/write own profile, admin can manage
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Purchases, supportTickets and other admin collections: admin read/write
    match /purchases/{document=**} {
      allow read, write: if isAdmin();
    }

    match /supportTickets/{document=**} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
