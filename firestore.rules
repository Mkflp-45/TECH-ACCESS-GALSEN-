rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        // Custom claim (voir admin-scripts/set-admin-claim.js) — méthode
        // recommandée. Le fallback par email reste en filet de sécurité ;
        // à retirer une fois la claim confirmée fonctionnelle.
        request.auth.token.admin == true || request.auth.token.email == "mohameth2051@gmail.com"
      );
    }

    // Products: public read, admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
      // Décrémentation du stock au moment d'une commande, sans passer par un
      // compte admin. Encadré strictement : seul le champ `stock` peut
      // changer, et uniquement pour baisser (jamais l'augmenter ni le
      // manipuler autrement). Toute autre modification reste réservée à
      // l'admin via la règle "write" ci-dessus.
      allow update: if !isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
    }

    // Promotions: authenticated users can read, admin can write
    match /promotions/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings: données publiques du site (ticker, catégories, taux de
    // change) — doivent être lisibles par tout visiteur, connecté ou non.
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: création ouverte (site en "guest checkout", sans compte requis),
    // avec validation minimale de la forme des données. Lecture/modif/suppr
    // réservées à l'admin, ou au client connecté propriétaire (via userId,
    // le champ réellement utilisé par main.js/main-additions.js).
    match /orders/{document=**} {
      allow create: if request.resource.data.total is number
                    && request.resource.data.total > 0
                    && request.resource.data.customer is map
                    && request.resource.data.customer.whatsapp is string
                    // Même validation de format que le formulaire (scripts/main.js),
                    // appliquée ici côté serveur pour empêcher tout contournement
                    // du formulaire (appel direct à l'API Firestore).
                    && request.resource.data.customer.whatsapp.matches('^[+]?[0-9 ]{8,15}$')
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0;
      allow read, update, delete: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
    }

    // Admin logs: admin only
    match /adminLogs/{document=**} {
      allow read, write: if isAdmin();
    }

    // Users: user can read/write own profile, admin can manage
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Bonus de parrainage : un utilisateur connecté peut créditer les
      // points d'un AUTRE compte (le parrain), mais seulement ce champ précis,
      // et seulement pour l'incrément fixe exact du bonus (500 pts) — jamais
      // pour modifier quoi que ce soit d'autre sur le compte de quelqu'un.
      allow update: if isSignedIn() && !isAdmin() && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loyaltyPoints'])
        && request.resource.data.loyaltyPoints == resource.data.loyaltyPoints + 500;
    }

    // Table de correspondance publique "code de parrainage -> uid", pour
    // pouvoir résoudre un code AVANT que le nouvel inscrit soit authentifié
    // (un code de parrainage est fait pour être partagé, donc pas sensible).
    // Le profil complet (users/{uid}) reste protégé normalement.
    match /referralCodes/{code} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Purchases, supportTickets and other admin collections: admin read/write
    match /purchases/{document=**} {
      allow read, write: if isAdmin();
    }

    match /supportTickets/{document=**} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
