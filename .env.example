# Firebase Configuration
# Copie ce fichier en .env.local et remplis avec tes vraies credentials.
# Ces valeurs Firebase (côté client) ne sont pas des secrets à proprement parler :
# la sécurité de Firebase repose sur firestore.rules, pas sur le fait de cacher apiKey.
FIREBASE_API_KEY=ta_cle_api_ici
FIREBASE_AUTH_DOMAIN=tech-acces-galsen.firebaseapp.com
FIREBASE_PROJECT_ID=tech-acces-galsen
FIREBASE_STORAGE_BUCKET=tech-acces-galsen.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=586222995096
FIREBASE_APP_ID=ta_app_id_ici
FIREBASE_MEASUREMENT_ID=ta_measurement_id_ici

# --- Paiement ---
# Le paiement se fait via un lien marchand Wave public (pay.wave.com), codé en
# dur dans scripts/main.js (constante WAVE_PAYMENT_LINK). Aucune clé API ou
# secrète n'est nécessaire pour ça — pas de variable d'environnement à définir.
